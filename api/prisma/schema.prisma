generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Vehicle {
  id        String   @id @default(uuid(7))
  placa     String   @unique
  chassi    String   @unique
  renavam   String   @unique
  modelo    String
  marca     String
  ano       Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
  @@schema("public")
}
